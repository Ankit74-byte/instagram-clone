import mongoose from 'mongoose';
import bcrypt from 'bcryptjs';
import dotenv from 'dotenv';

import User from './models/User.js';
import Post from './models/Post.js';

dotenv.config();

const demoUsers = [
  {
    fullName: 'Mila Spencer',
    username: 'mila',
    email: 'mila@example.com',
    bio: 'Coffee, sunsets, and travel.',
    avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=400&q=80',
  },
  {
    fullName: 'Liam Brooks',
    username: 'liam',
    email: 'liam@example.com',
    bio: 'Photographer and cyclist.',
    avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=400&q=80',
  },
  {
    fullName: 'Zoe Hart',
    username: 'zoe',
    email: 'zoe@example.com',
    bio: 'Creating memories in every city.',
    avatar: 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=400&q=80',
  },
];

const createSeedData = async () => {
  try {
    await mongoose.connect(process.env.MONGODB_URI || 'mongodb://localhost:27017/instagram-clone');
    await User.deleteMany({});
    await Post.deleteMany({});

    const users = await Promise.all(
      demoUsers.map(async (user) => {
        const password = await bcrypt.hash('password123', 10);
        return User.create({ ...user, password });
      })
    );

    const posts = [
      {
        user: users[0]._id,
        image: 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80',
        caption: 'Golden hour in the city.',
        likes: [users[1]._id, users[2]._id],
        comments: [
          { user: users[1]._id, text: 'This looks amazing!' },
          { user: users[2]._id, text: 'Love the color palette.' },
        ],
      },
      {
        user: users[1]._id,
        image: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1200&q=80',
        caption: 'Weekend adventure with the crew.',
        likes: [users[0]._id],
        comments: [{ user: users[0]._id, text: 'Need this trip plan!' }],
      },
      {
        user: users[2]._id,
        image: 'https://images.unsplash.com/photo-1493246507139-91e8fad9978e?auto=format&fit=crop&w=1200&q=80',
        caption: 'Fresh air and a clear mind.',
        likes: [users[0]._id, users[1]._id, users[2]._id],
        comments: [{ user: users[1]._id, text: 'Such a peaceful place.' }],
      },
    ];

    await Post.insertMany(posts);

    console.log('✅ Seed data inserted successfully.');
    console.log('Demo accounts:');
    demoUsers.forEach((user) => console.log(`${user.email} / password123`));
    process.exit(0);
  } catch (error) {
    console.error('❌ Seed failed:', error.message);
    process.exit(1);
  }
};

createSeedData();
